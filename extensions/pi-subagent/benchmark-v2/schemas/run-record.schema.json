{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MDGChamomile/pi-agent-kit/pi-subagent-benchmark-v2/run-record.schema.json",
  "title": "Pi Subagent Benchmark v2 Run Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark_id",
    "run_id",
    "task_id",
    "task_sha256",
    "arm",
    "profile",
    "repetition",
    "block_order",
    "process",
    "parent",
    "child",
    "tools",
    "derived",
    "final_answer",
    "raw_event_sha256"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "benchmark_id": { "type": "string", "minLength": 1, "maxLength": 120 },
    "run_id": { "type": "string", "pattern": "^[a-zA-Z0-9._-]{8,160}$" },
    "task_id": { "type": "string", "minLength": 1, "maxLength": 80 },
    "task_sha256": { "$ref": "#/$defs/sha256" },
    "arm": { "enum": ["direct", "delegated_matched", "delegated_production"] },
    "profile": { "enum": ["lookup", "analysis", "review"] },
    "repetition": { "type": "integer", "minimum": 1, "maximum": 3 },
    "block_order": { "type": "integer", "minimum": 1, "maximum": 3 },
    "process": { "$ref": "#/$defs/process" },
    "parent": { "$ref": "#/$defs/agent" },
    "child": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/child" }
      ]
    },
    "tools": {
      "type": "array",
      "items": { "$ref": "#/$defs/toolResult" }
    },
    "derived": { "$ref": "#/$defs/derived" },
    "final_answer": { "type": "string", "maxLength": 65536 },
    "error": {
      "type": ["string", "null"],
      "maxLength": 4096
    },
    "raw_event_sha256": { "$ref": "#/$defs/sha256" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "arm": { "const": "direct" } },
        "required": ["arm"]
      },
      "then": {
        "properties": { "child": { "type": "null" } }
      }
    },
    {
      "if": {
        "properties": {
          "arm": { "enum": ["delegated_matched", "delegated_production"] }
        },
        "required": ["arm"]
      },
      "then": {
        "properties": { "child": { "$ref": "#/$defs/child" } }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input",
        "cacheRead",
        "cacheWrite",
        "output",
        "totalTokens",
        "cost"
      ],
      "properties": {
        "input": { "type": "number", "minimum": 0 },
        "cacheRead": { "type": "number", "minimum": 0 },
        "cacheWrite": { "type": "number", "minimum": 0 },
        "cacheWrite1h": { "type": "number", "minimum": 0 },
        "output": { "type": "number", "minimum": 0 },
        "reasoning": { "type": "number", "minimum": 0 },
        "totalTokens": { "type": "number", "minimum": 0 },
        "cost": {
          "type": "object",
          "additionalProperties": false,
          "required": ["input", "cacheRead", "cacheWrite", "output", "total"],
          "properties": {
            "input": { "type": "number", "minimum": 0 },
            "cacheRead": { "type": "number", "minimum": 0 },
            "cacheWrite": { "type": "number", "minimum": 0 },
            "output": { "type": "number", "minimum": 0 },
            "total": { "type": "number", "minimum": 0 }
          }
        }
      }
    },
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "provider", "model", "stop_reason", "timestamp_ms", "usage"],
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "provider": { "type": "string", "minLength": 1, "maxLength": 120 },
        "model": { "type": "string", "minLength": 1, "maxLength": 200 },
        "stop_reason": { "type": ["string", "null"], "maxLength": 80 },
        "timestamp_ms": { "type": "integer", "minimum": 0 },
        "usage": { "$ref": "#/$defs/usage" }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "model",
        "thinking",
        "tool_calls_attempted",
        "tool_calls_executed",
        "denied_calls",
        "assistant_messages"
      ],
      "properties": {
        "provider": { "type": "string", "minLength": 1, "maxLength": 120 },
        "model": { "type": "string", "minLength": 1, "maxLength": 200 },
        "thinking": { "type": "string", "minLength": 1, "maxLength": 40 },
        "tool_calls_attempted": { "type": "integer", "minimum": 0 },
        "tool_calls_executed": { "type": "integer", "minimum": 0 },
        "denied_calls": { "type": "integer", "minimum": 0 },
        "assistant_messages": {
          "type": "array",
          "items": { "$ref": "#/$defs/message" }
        }
      }
    },
    "child": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "model",
        "thinking",
        "status",
        "partial_reason",
        "duration_ms",
        "tool_calls_attempted",
        "tool_calls_executed",
        "denied_calls",
        "usage"
      ],
      "properties": {
        "provider": { "type": "string", "minLength": 1, "maxLength": 120 },
        "model": { "type": "string", "minLength": 1, "maxLength": 200 },
        "thinking": { "type": "string", "minLength": 1, "maxLength": 40 },
        "status": { "enum": ["complete", "partial", "failure", "timeout"] },
        "partial_reason": { "type": ["string", "null"], "maxLength": 80 },
        "duration_ms": { "type": "integer", "minimum": 0 },
        "tool_calls_attempted": { "type": "integer", "minimum": 0 },
        "tool_calls_executed": { "type": "integer", "minimum": 0 },
        "denied_calls": { "type": "integer", "minimum": 0 },
        "usage": { "$ref": "#/$defs/usage" }
      }
    },
    "toolResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "tool_name", "bytes", "is_error", "after_subagent_result", "nested_usage"],
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "tool_name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "bytes": { "type": "integer", "minimum": 0 },
        "is_error": { "type": "boolean" },
        "after_subagent_result": { "type": "boolean" },
        "nested_usage": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/usage" }
          ]
        }
      }
    },
    "process": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "model_request_started",
        "started_at",
        "ended_at",
        "wall_time_ms",
        "exit_code",
        "timeout_phase"
      ],
      "properties": {
        "status": {
          "enum": ["complete", "partial", "failure", "timeout", "preflight_invalid"]
        },
        "model_request_started": { "type": "boolean" },
        "started_at": { "type": "string", "format": "date-time" },
        "ended_at": { "type": "string", "format": "date-time" },
        "wall_time_ms": { "type": "integer", "minimum": 0 },
        "exit_code": { "type": ["integer", "null"] },
        "timeout_phase": { "type": ["string", "null"], "maxLength": 80 }
      }
    },
    "derived": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parent_peak_prompt_tokens",
        "parent_cumulative_prompt_tokens",
        "parent_tool_result_bytes",
        "parent_subagent_result_bytes",
        "post_subagent_investigative_calls"
      ],
      "properties": {
        "parent_peak_prompt_tokens": { "type": "number", "minimum": 0 },
        "parent_cumulative_prompt_tokens": { "type": "number", "minimum": 0 },
        "parent_tool_result_bytes": { "type": "integer", "minimum": 0 },
        "parent_subagent_result_bytes": { "type": "integer", "minimum": 0 },
        "post_subagent_investigative_calls": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
