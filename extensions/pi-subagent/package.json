{
  "name": "pi-subagent-local",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --import ./scripts/pi-sdk-test-loader.mjs --experimental-strip-types --test *.test.ts && python3 -B -m unittest discover -s scripts -p '*_test.py'",
    "package:check": "node ../../packaging/pi-subagent/check.mjs",
    "test:web-schema": "node scripts/web-schema-canary.mjs",
    "eval:context": "python3 scripts/context_isolation_eval.py --mode context",
    "test:live:local": "python3 -B scripts/context_isolation_eval.py --mode smoke --capability local --preset all",
    "test:live:web": "python3 -B scripts/context_isolation_eval.py --mode smoke --capability web --preset all"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "1.0.0",
    "@earendil-works/pi-ai": "1.0.0",
    "@earendil-works/pi-coding-agent": "1.0.0",
    "@earendil-works/pi-tui": "1.0.0",
    "@types/node": "22.20.1",
    "typebox": "1.3.7",
    "typescript": "5.9.3"
  }
}
